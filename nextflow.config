// Minimal self-contained test for the reimplemented Nextflow #3530 hint:
//   scheduling.provisioningModel  (fork commit 029ea9eb3)
// Global spot on; per-process hints override it. P_DEFAULT has no hint and
// should fall back to the global spot=true setting. 'ondemand' is a valid
// alias for 'standard'.
google.batch.spot = true

process {
    // Google Batch requires a container image per task. Trivial public image.
    container = 'quay.io/nextflow/bash'

    withName: 'P_SPOT'     { hints = ['scheduling.provisioningModel': 'spot'] }
    withName: 'P_STD'      { hints = ['scheduling.provisioningModel': 'standard'] }
    withName: 'P_ONDEMAND' { hints = ['scheduling.provisioningModel': 'ondemand'] }
    withName: 'P_PREEMPT'  { hints = ['scheduling.provisioningModel': 'preemptible'] }

    // Instance-template case: machineType via template:// + a provisioningModel
    // hint. The 'nf-provmodel-tmpl' instance template is created in the next phase.
    withName: 'P_TEMPLATE' {
        machineType = 'template://nf-provmodel-tmpl'
        hints = ['scheduling.provisioningModel': 'spot']
    }
}
